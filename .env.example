# Copy to .env for local development. Never commit .env. On Vercel set these in
# Project -> Settings -> Environment Variables.

# REQUIRED - hosted PostgreSQL connection string (use the provider's *pooled* URL on Vercel).
# Vercel's Neon / Supabase integrations set DATABASE_URL (and POSTGRES_URL) for you.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# REQUIRED in production - any long random string. Needed to initialise/advance the simulator.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Optional
ENVIRONMENT=development
SIM_DEVICE_COUNT=24
SIM_SEED=42
ACTIVE_WINDOW_MINUTES=60
RETENTION_HOURS=72
# CORS_ORIGINS=https://other-frontend.example   # not needed: the UI and API share one origin
# DEV_API_PROXY=http://127.0.0.1:8000           # local `npm run dev` only
