# Copy to .env for local development. Never commit .env. On Vercel set these in
# Project -> Settings -> Environment Variables.

# OPTIONAL. Without it TWIN runs in DEMO MODE (synthetic, read-only, not persisted).
# With it TWIN uses PostgreSQL: tables + the simulated factory are created automatically, once.
# Vercel's Neon / Supabase integrations set DATABASE_URL (and POSTGRES_URL) for you; use the *pooled* URL.
DATABASE_URL=

# Needed only for write actions in PostgreSQL mode (inject scenarios, advance simulation, resolve incidents).
# Without it, writes are refused on Vercel production/preview. Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Optional
# DEMO_MODE=true                 # force demo data even when DATABASE_URL is set
ENVIRONMENT=development
SIM_DEVICE_COUNT=24
SIM_SEED=42
ACTIVE_WINDOW_MINUTES=60
RETENTION_HOURS=72
# CORS_ORIGINS=https://other-frontend.example   # not needed: the UI and API share one origin
# DEV_API_PROXY=http://127.0.0.1:8000           # local `npm run dev` only
